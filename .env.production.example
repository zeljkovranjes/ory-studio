# Production environment for ory-studio. Copy to .env on the host and fill in.
# NEVER commit a real .env (it is git-ignored).

# --- Domains (Caddy auto-provisions TLS for these) ---
STUDIO_DOMAIN=studio.example.com
AUTH_DOMAIN=auth.example.com
KRATOS_PUBLIC_DOMAIN=identity.example.com
HYDRA_PUBLIC_DOMAIN=oauth.example.com

# --- Tenancy ---
TENANCY_MODE=single

# --- Studio login (cookie session over HTTPS) ---
STUDIO_ADMIN_USER=admin
STUDIO_ADMIN_PASSWORD=use-a-long-random-password
STUDIO_SESSION_SECRET=generate-a-32+char-random-secret
STUDIO_SECURE_COOKIES=true

# --- Postgres (use a strong password) ---
POSTGRES_PASSWORD=use-a-strong-db-password

# --- Service endpoints (internal docker network) ---
ORY_KRATOS_ADMIN_URL=http://kratos:4434
ORY_KRATOS_PUBLIC_URL=https://identity.example.com
ORY_HYDRA_ADMIN_URL=http://hydra:4445
ORY_KETO_READ_URL=http://keto:4466
ORY_KETO_WRITE_URL=http://keto:4467

# --- Config engine (paths mounted into the studio container) ---
KRATOS_CONFIG_PATH=/etc/config/kratos/kratos.yml
HYDRA_CONFIG_PATH=/etc/config/hydra/hydra.yml
KETO_NAMESPACES_PATH=/etc/config/keto/namespaces.keto.ts

# --- Studio database + activity capture ---
DATABASE_URL=postgres://ory:use-a-strong-db-password@postgres:5432/studio
STUDIO_COLLECTOR_TOKEN=generate-a-random-collector-token
STUDIO_INTERNAL_URL=http://studio:3000
