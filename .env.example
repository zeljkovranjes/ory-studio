# --- Studio ---
# single | multi — tenancy toggle (single is the default product shape)
TENANCY_MODE=single
# Studio login (cookie session). Leave password empty to disable auth in local dev.
STUDIO_ADMIN_USER=admin
STUDIO_ADMIN_PASSWORD=change-me
# Optional: explicit session signing secret. If unset, derived from the password.
STUDIO_SESSION_SECRET=
# Set true when serving the studio over HTTPS so the session cookie is Secure.
STUDIO_SECURE_COOKIES=false

# --- Ory service endpoints (defaults match docker-compose.yml) ---
ORY_KRATOS_ADMIN_URL=http://localhost:4434
ORY_KRATOS_PUBLIC_URL=http://localhost:4433
# Internally-reachable Kratos public URL for the studio's server-side calls
# (/schemas). Only needed when the public URL above is browser-facing (localhost)
# and not reachable from the studio process; defaults to ORY_KRATOS_PUBLIC_URL.
# In docker-compose this is set to http://kratos:4433.
# ORY_KRATOS_PUBLIC_INTERNAL_URL=http://kratos:4433
ORY_HYDRA_ADMIN_URL=http://localhost:4445
ORY_KETO_READ_URL=http://localhost:4466
ORY_KETO_WRITE_URL=http://localhost:4467

# --- Config engine ---
# Paths to the service configs the studio reads/writes (mounted into the containers)
KRATOS_CONFIG_PATH=./config/kratos/kratos.yml
HYDRA_CONFIG_PATH=./config/hydra/hydra.yml

# --- Studio database (events, actions, members) ---
DATABASE_URL=postgres://ory:placeholder-password@localhost:5432/studio

# --- Activity capture ---
# Shared secret the Kratos collector webhooks send as X-Collector-Token
STUDIO_COLLECTOR_TOKEN=change-me-collector-token
# Studio URL reachable FROM the kratos container (compose default below)
STUDIO_INTERNAL_URL=http://studio:3000
